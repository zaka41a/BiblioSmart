{
  "name": "bibliosmart",
  "private": true,
  "version": "0.1.0",
  "description": "BiblioSmart · Modern library platform (monorepo)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev:frontend & npm run dev:backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "cd frontend && npm install && npm run build",
    "build:frontend": "npm run build --workspace frontend",
    "build:backend": "npm run build --workspace backend",
    "preview": "npm run preview --workspace frontend",
    "db:studio": "npm run prisma:studio --workspace backend",
    "lint": "npm run lint --workspace frontend && npm run lint --workspace backend",
    "format": "npm run format --workspace frontend"
  }
}
